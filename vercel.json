{
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sb/rest/v1/:path*",
      "destination": "https://johtzljxyzcbijlniipc.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/sb/storage/v1/:path*",
      "destination": "https://johtzljxyzcbijlniipc.supabase.co/storage/v1/:path*"
    },
    {
      "source": "/sb/auth/v1/:path*",
      "destination": "https://johtzljxyzcbijlniipc.supabase.co/auth/v1/:path*"
    }
  ]
}
